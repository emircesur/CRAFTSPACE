    {
      "id": "craftspace-doom",
      "name": "Doom for PhotoCraft",
      "kind": "plugin",
      "version": "1.0.1",
      "requires": "0.1.5",
      "author": "CraftSpace",
      "license": "GPL-2.0-or-later AND BSD-3-Clause",
      "trust": "checked",
      "description": "Play Doom (Freedoom: Phase 1, episode 1) on a PhotoCraft canvas (640 x 400; on a larger document it takes the top-left 640 x 400), a move at a time: double-click the Doom moves in Window › Actions (PhotoCraft versions after 0.5.0 also play them with Alt+Shift+W A S D, Q E, F, Space). Undo takes a move back. The game is kept in the picture itself.",
      "apps": [
        "photocraft"
      ],
      "tags": [
        "game",
        "plug-in"
      ],
      "homepage": "https://github.com/emircesur/doom-in-photocraft",
      "files": [
        {
          "url": "https://github.com/emircesur/doom-in-photocraft/releases/download/v1.0.1/doom-in-photocraft-1.0.1.zip",
          "sha256": "c30ad92cc0de0d14ef822eac5eb4c966a6c7febe16c852c763bddad920e78ef9"
        }
      ],
      "install": [
        {
          "app": "photocraft",
          "to": "plugins",
          "files": [
            "doom-photocraft.wasm"
          ]
        },
        {
          "app": "photocraft",
          "to": "actions",
          "files": [
            "doom-actions.json"
          ],
          "hint": "New 640 x 400 document, then double-click a Doom move in Window › Actions."
        }
      ]
    },
