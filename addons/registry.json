{
  "format": "craftspace-addons",
  "version": 1,
  "addons": [
    {
      "id": "craftspace-palettes",
      "name": "CraftSpace Palettes",
      "kind": "pack",
      "version": "1",
      "author": "CraftSpace",
      "license": "CC0-1.0",
      "trust": "checked",
      "description": "Seven colour palettes: a 14-hue spectrum in six tones, neutrals, pastels, earth, ocean, skin tones and web-safe colours.",
      "apps": [
        "vectorcraft",
        "photocraft",
        "designcraft"
      ],
      "tags": [
        "swatches",
        "palettes",
        "colour"
      ],
      "homepage": "https://github.com/emircesur/CRAFTSPACE/tree/main/addons",
      "files": [
        {
          "url": "https://raw.githubusercontent.com/emircesur/CRAFTSPACE/main/addons/packs/craftspace-palettes-1.zip",
          "sha256": "e1793e2f79ef5fe8d30a4a210ff04af5d90fee24e1f00df7ccb4f57834452ecb"
        }
      ],
      "install": [
        {
          "app": "vectorcraft",
          "to": "app:config/Swatches",
          "files": [
            "GIMP palettes/*.gpl"
          ],
          "hint": "In VectorCraft they're in the Swatches panel under User Defined."
        },
        {
          "app": "photocraft",
          "to": "library",
          "files": [
            "Photoshop swatches/*.aco"
          ],
          "open": true,
          "hint": "PhotoCraft adds them to its Swatches panel when they open in it."
        },
        {
          "app": "designcraft",
          "to": "library",
          "files": [
            "Adobe swatch exchange/*.ase"
          ],
          "hint": "In DesignCraft: Swatches panel menu › Load Swatches…"
        }
      ]
    },
    {
      "id": "craftspace-looks",
      "name": "CraftSpace Looks",
      "kind": "pack",
      "version": "1",
      "author": "CraftSpace",
      "license": "CC0-1.0",
      "trust": "checked",
      "description": "Twelve 3D LUT looks (.cube): warm, cool, teal and orange, faded film, bleach bypass, sepia, cross process, moonlight, golden hour, vivid and two monochromes.",
      "apps": [
        "lightcraft",
        "filmcraft",
        "effectcraft",
        "photocraft"
      ],
      "tags": [
        "lut",
        "cube",
        "colour grading",
        "looks"
      ],
      "homepage": "https://github.com/emircesur/CRAFTSPACE/tree/main/addons",
      "files": [
        {
          "url": "https://raw.githubusercontent.com/emircesur/CRAFTSPACE/main/addons/packs/craftspace-looks-1.zip",
          "sha256": "efe76f340c29a3ae2bf694e83905b6505b73913a7987ce70dd30325d1b1c83a5"
        }
      ],
      "install": [
        {
          "app": "lightcraft",
          "to": "library",
          "files": [
            "CraftSpace Looks/*.cube"
          ],
          "hint": "In LightCraft: File › Import Profiles & Presets…, then choose the CraftSpace Looks folder."
        },
        {
          "app": "filmcraft",
          "to": "library",
          "files": [
            "CraftSpace Looks/*.cube"
          ],
          "hint": "In FilmCraft: Lumetri Color › Creative › Look › Browse…"
        },
        {
          "app": "effectcraft",
          "to": "library",
          "files": [
            "CraftSpace Looks/*.cube"
          ],
          "hint": "In EffectCraft: Effect › Utility › Apply Color LUT."
        },
        {
          "app": "photocraft",
          "to": "library",
          "files": [
            "CraftSpace Looks/*.cube"
          ],
          "hint": "In PhotoCraft: Image › Adjustments › Color Lookup…"
        }
      ]
    },
